NAME = pipex

CC = cc
CFLAGS = -Wall -Wextra -Werror

SRC = split.c  strjoin.c  utils.c main.c path.c files.c pipex.c

OBJ = $(SRC:.c=.o)

all: $(NAME)

$(NAME): $(OBJ)
	$(CC) $(CFLAGS) $(OBJ) -o $(NAME)
clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
